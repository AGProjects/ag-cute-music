<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- the hardened runtime (needed for notarization) with what Python and GStreamer need: ctypes/libffi
         closures and GStreamer's orc compile code at run time -->
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <!-- py2app's Python, Qt and GStreamer load their libraries and plugins by path -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <!-- the hardened runtime blocks the microphone without it: the mixer's MIC would read silence -->
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <!-- the hardened runtime blocks Apple events without it: what Spotify or Music plays (taps.now_playing) -->
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
